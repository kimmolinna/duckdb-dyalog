∇body←plotHtmlBody
⍝ Client script (module) for WebSocket Arrow IPC + Observable Plot.
 body←'<script type="module">'
 body,←'import { tableFromIPC } from "https://cdn.jsdelivr.net/npm/apache-arrow@17.0.0/+esm";'
 body,←'import * as Plot from "https://cdn.jsdelivr.net/npm/@observablehq/plot@0.6/+esm";'
 body,←'const spec = window.__PLOT_SPEC__ || {};'
 body,←'const status = document.querySelector("#status");'
 body,←'const root = document.querySelector("#plot");'
 body,←'function showError(err){status.textContent = String(err);console.error(err);}'
 body,←'function render(table){'
 body,←'  const type = spec.type || "barY";'
 body,←'  if(typeof Plot[type] !== "function") throw new Error("Unknown plot type: "+type);'
 body,←'  const opts = { x: spec.x, y: spec.y };'
 body,←'  if(spec.fill) opts.fill = spec.fill;'
 body,←'  if(spec.stroke) opts.stroke = spec.stroke;'
 body,←'  const mark = Plot[type](table, opts);'
 body,←'  const plotOpts = { marks: [mark] };'
 body,←'  if(spec.title) plotOpts.title = spec.title;'
 body,←'  if(spec.width) plotOpts.width = spec.width;'
 body,←'  if(spec.height) plotOpts.height = spec.height;'
 body,←'  root.replaceChildren(Plot.plot(plotOpts));'
 body,←'  status.textContent = `${table.numRows} rows`;'
 body,←'}'
 body,←'const ws = new WebSocket("ws://dyalog_root/plot");'
 body,←'ws.binaryType = "arraybuffer";'
 body,←'ws.onopen = () => { status.textContent = "Connected, requesting data…"; ws.send(JSON.stringify({cmd:"ready"})); };'
 body,←'ws.onmessage = async (evt) => {'
 body,←'  try {'
 body,←'    if(typeof evt.data === "string") return;'
 body,←'    const table = await tableFromIPC(new Uint8Array(evt.data));'
 body,←'    render(table);'
 body,←'  } catch (err) { showError(err); }'
 body,←'};'
 body,←'ws.onerror = () => showError("WebSocket error");'
 body,←'ws.onclose = () => status.textContent = "WebSocket closed";'
 body,←'</script>'
∇
