 testDateTimeCrashLab;variant;r;lib;f;out;days;micros;ok;ptr;packed;bytes
⍝ Crash-lab for date/time conversion NA signatures.
⍝ Default safe mode (variant 0) skips risky calls.
⍝ Set dateTimeVariant (global) to choose variant:
⍝   0 = safe mode (skip)
⍝   1 = duckdb_from_date  as {I4 I1 I1} <- I4
⍝   2 = duckdb_to_date    as I4 <- {I4 I1 I1}
⍝   3 = duckdb_from_time  as {I1 I1 I1 I4} <- I8
⍝   4 = duckdb_to_time    as I8 <- {I1 I1 I1 I4}
⍝   5 = finite checks only (I1 <- I4 / I8)
⍝   6 = duckdb_from_date  as I8 <- I4 (raw packed return)
⍝   7 = RESERVED (disabled: to_date raw I8 can hang/crash)
⍝   8 = duckdb_from_time  as I8 <- I8 (raw packed return)
⍝   9 = duckdb_to_time    as I8 <- I8 (raw packed arg)
⍝  10 = RESERVED (disabled: to_date flattened fields can crash)
⍝  11 = RESERVED (disabled: to_time flattened fields not safe yet)
⍝  12 = duckdb_to_date    as I4 <- U8 (raw packed unsigned arg)
⍝  13 = duckdb_to_time    as I8 <- U8 (raw packed unsigned arg)
⍝  14 = duckdb_to_date    as I4 <- <{I4 I1 I1}[] (by-ref probe)
⍝  15 = duckdb_to_time    as I8 <- <{I1 I1 I1 I4}[] (by-ref probe)
⍝  16 = duckdb_to_date    as I4 <- P      (ptr to packed u64 struct)
⍝  17 = duckdb_to_date    as I4 <- <P[]   (ptr-by-ref packed u64)
⍝  18 = duckdb_to_time    as I8 <- P      (ptr to packed u64 struct)
⍝  19 = duckdb_to_time    as I8 <- <P[]   (ptr-by-ref packed u64)
⍝  20 = duckdb_to_date    as I4 <- I4 I1 I1 I1 I1 (explicit pad bytes)
⍝  21 = duckdb_to_time    as I8 <- I1 I1 I1 I1 I4 (explicit pad byte)

 :If 0=⎕NC'null'
     init'lib/'
 :EndIf

 variant←21
 :If 0<⎕NC'dateTimeVariant'
     variant←dateTimeVariant
 :EndIf

 r←⊂'Test Date/Time Crash-Lab'
 r,←⊂'Selected variant: ',⍕variant
 lib←ducklibpath
 ok←1

 :If variant=0
     r,←⊂'date/time conversion call skipped (safe mode) - OK'
     ⎕←↑r
     ⎕←''
     ⎕←'Crash-lab complete.'
     →0
 :EndIf

 :Trap 0
     :Select variant
     :Case 1
         f←⍎⎕NA'{I4 I1 I1} ',lib,'|duckdb_from_date I4'
         days←0
         out←f days
         r,←⊂'from_date call returned - OK'
         r,←⊂'from_date output: ',⍕out
     :Case 2
         f←⍎⎕NA'I4 ',lib,'|duckdb_to_date {I4 I1 I1}'
         out←f(1970 1 1)
         r,←⊂'to_date call returned - OK'
         r,←⊂'to_date output: ',⍕out
     :Case 3
         f←⍎⎕NA'{I1 I1 I1 I4} ',lib,'|duckdb_from_time I8'
         micros←3723004005
         out←f micros
         r,←⊂'from_time call returned - OK'
         r,←⊂'from_time output: ',⍕out
     :Case 4
         f←⍎⎕NA'I8 ',lib,'|duckdb_to_time {I1 I1 I1 I4}'
         out←f(1 2 3 4005)
         r,←⊂'to_time call returned - OK'
         r,←⊂'to_time output: ',⍕out
     :Case 5
         f←⍎⎕NA'I1 ',lib,'|duckdb_is_finite_date I4'
         out←f 0
         r,←⊂'is_finite_date call returned - OK'
         r,←⊂'is_finite_date output: ',⍕out
         f←⍎⎕NA'I1 ',lib,'|duckdb_is_finite_timestamp I8'
         out←f 0
         r,←⊂'is_finite_timestamp call returned - OK'
         r,←⊂'is_finite_timestamp output: ',⍕out
     :Case 6
         f←⍎⎕NA'I8 ',lib,'|duckdb_from_date I4'
         out←f 0
         r,←⊂'from_date raw I8 call returned - OK'
         r,←⊂'from_date raw I8: ',⍕out
     :Case 7
         r,←⊂'Variant 7 disabled (known hang/crash path) - SKIPPED'
     :Case 8
         f←⍎⎕NA'I8 ',lib,'|duckdb_from_time I8'
         out←f 3723004005
         r,←⊂'from_time raw I8 call returned - OK'
         r,←⊂'from_time raw I8: ',⍕out
     :Case 9
        ⍝ Raw packed time struct approx for 01:02:03.004005
         f←⍎⎕NA'I8 ',lib,'|duckdb_to_time I8'
         out←f 17201836916737
         r,←⊂'to_time raw I8 call returned - OK'
         r,←⊂'to_time raw output: ',⍕out
     :Case 10
         r,←⊂'Variant 10 disabled (known crash path) - SKIPPED'
     :Case 11
         r,←⊂'Variant 11 disabled pending safe ABI mapping - SKIPPED'
     :Case 12
         f←⍎⎕NA'I4 ',lib,'|duckdb_to_date U8'
         out←f 1103806597042
         r,←⊂'to_date raw U8 call returned - OK'
         r,←⊂'to_date raw U8 output: ',⍕out
     :Case 13
         f←⍎⎕NA'I8 ',lib,'|duckdb_to_time U8'
         out←f 17201344217601
         r,←⊂'to_time raw U8 call returned - OK'
         r,←⊂'to_time raw U8 output: ',⍕out
     :Case 14
         f←⍎⎕NA'I4 ',lib,'|duckdb_to_date <{I4 I1 I1}[]'
         out←f 1970 1 1
         r,←⊂'to_date by-ref struct probe returned - OK'
         r,←⊂'to_date by-ref output: ',⍕out
     :Case 15
         f←⍎⎕NA'I8 ',lib,'|duckdb_to_time <{I1 I1 I1 I4}[]'
         out←f 1 2 3 4005
         r,←⊂'to_time by-ref struct probe returned - OK'
         r,←⊂'to_time by-ref output: ',⍕out
     :Case 16
        ⍝ duckdb_date_struct bytes (little-endian): I4 year, I1 month, I1 day, 2 bytes pad
         bytes←178 7 0 0 1 1 0 0
         ptr←api.duckdb_malloc 8
         :If ptr=0
             r,←⊂'malloc failed - FAILED'
         :Else
             {}ptr write.u8 bytes
             f←⍎⎕NA'I4 ',lib,'|duckdb_to_date P'
             out←f ptr
             r,←⊂'to_date pointer-pack(P) returned - OK'
             r,←⊂'to_date pointer-pack(P) output: ',⍕out
             {}api.duckdb_free ptr
         :EndIf
     :Case 17
         bytes←178 7 0 0 1 1 0 0
         ptr←api.duckdb_malloc 8
         :If ptr=0
             r,←⊂'malloc failed - FAILED'
         :Else
             {}ptr write.u8 bytes
             f←⍎⎕NA'I4 ',lib,'|duckdb_to_date <P[]'
             out←f ptr
             r,←⊂'to_date pointer-pack(<P[]) returned - OK'
             r,←⊂'to_date pointer-pack(<P[]) output: ',⍕out
             {}api.duckdb_free ptr
         :EndIf
     :Case 18
        ⍝ duckdb_time_struct bytes (little-endian): I1 hour, I1 min, I1 sec, 1 byte pad, I4 micros
         bytes←1 2 3 0 165 15 0 0
         ptr←api.duckdb_malloc 8
         :If ptr=0
             r,←⊂'malloc failed - FAILED'
         :Else
             {}ptr write.u8 bytes
             f←⍎⎕NA'I8 ',lib,'|duckdb_to_time P'
             out←f ptr
             r,←⊂'to_time pointer-pack(P) returned - OK'
             r,←⊂'to_time pointer-pack(P) output: ',⍕out
             {}api.duckdb_free ptr
         :EndIf
     :Case 19
         bytes←1 2 3 0 165 15 0 0
         ptr←api.duckdb_malloc 8
         :If ptr=0
             r,←⊂'malloc failed - FAILED'
         :Else
             {}ptr write.u8 bytes
             f←⍎⎕NA'I8 ',lib,'|duckdb_to_time <P[]'
             out←f ptr
             r,←⊂'to_time pointer-pack(<P[]) returned - OK'
             r,←⊂'to_time pointer-pack(<P[]) output: ',⍕out
             {}api.duckdb_free ptr
         :EndIf
     :Case 20
         f←⍎⎕NA'I4 ',lib,'|duckdb_to_date {I4 I1 I1 I1 I1}'
         out←f⊂2026 1 1 0 0
         r,←⊂'to_date flattened+pad call returned - OK'
         r,←⊂'to_date flattened+pad output: ',⍕out
     :Case 21
         f←⍎⎕NA'I8 ',lib,'|duckdb_to_time {I1 I1 I1 I1 I4}'
         out←f 1 2 3 0 4005
         r,←⊂'to_time flattened+pad call returned - OK'
         r,←⊂'to_time flattened+pad output: ',⍕out
     :Else
         ok←0
         r,←⊂'Unknown variant - FAILED'
     :EndSelect
 :Else
     ok←0
     r,←⊂'date/time call failed - FAILED: ',⎕DMX.Message
 :EndTrap

 :If ok
     r,←⊂'Crash-lab variant completed'
 :EndIf

 ⎕←↑r
 ⎕←''
 ⎕←'Crash-lab complete.'

⍝ KSL 1.0.0
