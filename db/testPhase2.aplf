 testPhase2;r;req;db;con;result;st;stmt;pending;state;iter;out;msg;appender;app_msg
⍝ Test Phase 2: Advanced Data Types
:If 0=⎕NC'null'
    init 'lib/'
:EndIf

req←{0::⍺,' - FAILED: ',⎕DMX.Message ⋄ ⍵:⍺,' - OK' ⋄ ⍺,' - FAILED'}

⍝ ===== LIST TYPE TEST =====
r←⊂'Test LIST Type'
db←open':memory:'
con←connect db

⍝ Create table with LIST column
{}query con'CREATE TABLE list_test(id INT, numbers INT[])'
{}query con'INSERT INTO list_test VALUES (1, [1, 2, 3])'
{}query con'INSERT INTO list_test VALUES (2, [10, 20])'
{}query con'INSERT INTO list_test VALUES (3, [])'

result←query con'SELECT * FROM list_test ORDER BY id'
r,←⊂'LIST query executed'req 3=≢result

⍝ Check if lists were read correctly
:If 3=≢result
    ids←⊃1⊃result
    lists←1⊃1⊃result
    r,←⊂'First list correct'req(1 2 3)≡⊃lists
    r,←⊂'Second list correct'req(10 20)≡1⊃lists
    r,←⊂'Third list (empty) correct'req 0=≢2⊃lists
:EndIf

{}disconnect con
{}close db
⎕←↑r

⍝ ===== STRUCT TYPE TEST =====
r←⊂'Test STRUCT Type'
db←open':memory:'
con←connect db

⍝ Create table with STRUCT column
{}query con'CREATE TABLE struct_test(id INT, person STRUCT(name VARCHAR, age INT))'
{}query con'INSERT INTO struct_test VALUES (1, {''name'': ''Alice'', ''age'': 30})'
{}query con'INSERT INTO struct_test VALUES (2, {''name'': ''Bob'', ''age'': 25})'

result←query con'SELECT * FROM struct_test ORDER BY id'
r,←⊂'STRUCT query executed'req 3=≢result

⍝ Check if structs were read correctly
:If 3=≢result
    structs←1⊃1⊃result
    r,←⊂'First struct name correct'req'Alice'≡(0⊃structs).name
    r,←⊂'First struct age correct'req 30=(0⊃structs).age
    r,←⊂'Second struct name correct'req'Bob'≡(1⊃structs).name
:EndIf

{}disconnect con
{}close db
⎕←↑r

⍝ ===== MAP TYPE TEST =====
r←⊂'Test MAP Type'
db←open':memory:'
con←connect db

{}query con'CREATE TABLE map_test(id INT, attrs MAP(VARCHAR, INT))'
{}query con'INSERT INTO map_test VALUES (1, MAP {''a'': 1, ''b'': 2})'
{}query con'INSERT INTO map_test VALUES (2, MAP {''x'': 10})'

result←query con'SELECT * FROM map_test ORDER BY id'
r,←⊂'MAP query executed'req 3=≢result

⍝ Check if maps were read correctly
:If 3=≢result
    maps←1⊃1⊃result
    r,←⊂'First map has keys'req 2=≢(0⊃maps).keys
    r,←⊂'Second map has one key'req 1=≢(1⊃maps).keys
:EndIf

{}disconnect con
{}close db
⎕←↑r

⍝ ===== ENUM TYPE TEST =====
r←⊂'Test ENUM Type'
db←open':memory:'
con←connect db

{}query con'CREATE TYPE mood AS ENUM (''happy'', ''sad'', ''neutral'')'
{}query con'CREATE TABLE enum_test(id INT, feeling mood)'
{}query con'INSERT INTO enum_test VALUES (1, ''happy''::mood)'
{}query con'INSERT INTO enum_test VALUES (2, ''sad''::mood)'

result←query con'SELECT * FROM enum_test ORDER BY id'
r,←⊂'ENUM query executed'req 3=≢result

⍝ Check if enums were read correctly
:If 3=≢result
    feelings←1⊃1⊃result
    r,←⊂'First enum correct'req'happy'≡0⊃feelings
    r,←⊂'Second enum correct'req'sad'≡1⊃feelings
:EndIf

{}disconnect con
{}close db
⎕←↑r

⍝ ===== NESTED LIST TEST =====
r←⊂'Test Nested LIST'
db←open':memory:'
con←connect db

{}query con'CREATE TABLE nested_test(id INT, matrix INT[][])'
{}query con'INSERT INTO nested_test VALUES (1, [[1, 2], [3, 4]])'

result←query con'SELECT * FROM nested_test'
r,←⊂'Nested LIST query executed'req 3=≢result

{}disconnect con
{}close db
⎕←↑r

⍝ ===== PENDING/STREAMING API TEST =====
r←⊂'Test Pending/Streaming API'
db←open':memory:'
con←connect db

stmt←prepareQuery con'SELECT i FROM range(10000) t(i)'
r,←⊂'Prepare statement'req stmt≠0

:If stmt≠0
    (st pending)←api.duckdb_pending_prepared stmt 0
    r,←⊂'Create pending result'req(DuckDBSuccess=st)∧pending≠0

    :If (DuckDBSuccess=st)∧pending≠0
        state←api.duckdb_pending_execute_task pending
        iter←0
        :While (~api.duckdb_pending_execution_is_finished state)∧iter<100000
            state←api.duckdb_pending_execute_task pending
            iter+←1
        :EndWhile
        r,←⊂'Pending reached finished state'req api.duckdb_pending_execution_is_finished state
        (st out)←api.duckdb_execute_pending pending 6
        r,←⊂'Execute pending to result'req DuckDBSuccess=st
        :If DuckDBSuccess=st
            {}api.duckdb_destroy_result⊂out
        :EndIf
        {}api.duckdb_destroy_pending pending
    :Else
        msg←1024 read.utf8 api.duckdb_pending_error pending
        r,←⊂'Pending error message available'req 0<≢msg
        {}api.duckdb_destroy_pending pending
    :EndIf

    {}destroyPrepared stmt
:EndIf

{}disconnect con
{}close db
⎕←↑r

⍝ ===== APPENDER ROW-WISE API TEST =====
r←⊂'Test Appender Row-wise API'
db←open':memory:'
con←connect db

{}query con'CREATE TABLE app_row_test(id INT, name VARCHAR)'
(st appender)←api.duckdb_appender_create con '' 'app_row_test' 0
r,←⊂'Create appender for row-wise API'req(DuckDBSuccess=st)∧appender≠0

:If (DuckDBSuccess=st)∧appender≠0
    r,←⊂'Begin row wrapper status'req DuckDBSuccess=appenderBeginRow appender
    r,←⊂'Append INT32 value'req DuckDBSuccess=api.duckdb_append_int32 appender 1
    r,←⊂'Append VARCHAR value'req DuckDBSuccess=api.duckdb_append_varchar appender 'alpha'
    r,←⊂'End row wrapper status'req DuckDBSuccess=appenderEndRow appender

    r,←⊂'Begin second row'req DuckDBSuccess=appenderBeginRow appender
    r,←⊂'Append second row INT32'req DuckDBSuccess=api.duckdb_append_int32 appender 2
    r,←⊂'Append second row NULL string'req DuckDBSuccess=api.duckdb_append_null appender
    r,←⊂'End second row'req DuckDBSuccess=appenderEndRow appender

    r,←⊂'Flush wrapper status'req DuckDBSuccess=appenderFlush appender
    r,←⊂'Close wrapper status'req DuckDBSuccess=appenderClose appender
    r,←⊂'Destroy appender pointer'req DuckDBSuccess=api.duckdb_appender_destroy appender

    result←query con'SELECT * FROM app_row_test ORDER BY id'
    r,←⊂'Row-wise appender inserted two rows'req 2=≢⊃1⊃result
:Else
    app_msg←appenderError appender
    r,←⊂'Appender error message available'req 0<≢app_msg
:EndIf

⍝ Invalid pointer checks (error paths)
⍝ begin_row is a backwards-compat no-op in newer DuckDB builds
r,←⊂'Begin row null pointer is tolerated (no-op)'req DuckDBSuccess=appenderBeginRow 0
r,←⊂'End row null pointer returns error'req DuckDBError=appenderEndRow 0
r,←⊂'Flush null pointer returns error'req DuckDBError=appenderFlush 0
r,←⊂'Close null pointer returns error'req DuckDBError=appenderClose 0

{}disconnect con
{}close db
⎕←↑r

⍝ ===== APPENDER CLEAR/COLUMN API TEST =====
r←⊂'Test Appender Clear/Columns API'
db←open':memory:'
con←connect db

{}query con'CREATE TABLE app_clear_test(id INT, name VARCHAR)'
(st appender)←api.duckdb_appender_create con '' 'app_clear_test' 0
r,←⊂'Create appender for clear API'req(DuckDBSuccess=st)∧appender≠0

:If (DuckDBSuccess=st)∧appender≠0
    r,←⊂'Begin row for clear test'req DuckDBSuccess=appenderBeginRow appender
    r,←⊂'Append clear-test INT32 value'req DuckDBSuccess=api.duckdb_append_int32 appender 99
    r,←⊂'Append clear-test VARCHAR value'req DuckDBSuccess=api.duckdb_append_varchar appender 'discard'
    r,←⊂'End row for clear test'req DuckDBSuccess=appenderEndRow appender
    r,←⊂'Clear buffered rows status'req DuckDBSuccess=appenderClear appender
    r,←⊂'Close appender after clear'req DuckDBSuccess=appenderClose appender
    r,←⊂'Destroy appender after clear'req DuckDBSuccess=api.duckdb_appender_destroy appender

    result←query con'SELECT COUNT(*) AS n FROM app_clear_test'
    r,←⊂'Clear discarded buffered rows'req 0=⊃⊃1⊃result
:EndIf

{}query con'CREATE TABLE app_cols_test(id INT, name VARCHAR, note VARCHAR DEFAULT ''n/a'')'
(st appender)←api.duckdb_appender_create con '' 'app_cols_test' 0
r,←⊂'Create appender for column API'req(DuckDBSuccess=st)∧appender≠0

:If (DuckDBSuccess=st)∧appender≠0
    r,←⊂'Add active column id'req DuckDBSuccess=appenderAddColumn appender 'id'
    r,←⊂'Add active column name'req DuckDBSuccess=appenderAddColumn appender 'name'
    r,←⊂'Clear active columns list'req DuckDBSuccess=appenderClearColumns appender
    r,←⊂'Close column API appender'req DuckDBSuccess=appenderClose appender
    r,←⊂'Destroy column API appender'req DuckDBSuccess=api.duckdb_appender_destroy appender
:EndIf

⍝ Null pointer checks (error paths)
r,←⊂'Clear null pointer returns error'req DuckDBError=appenderClear 0
r,←⊂'Add column null pointer returns error'req DuckDBError=appenderAddColumn 0 'id'
r,←⊂'Clear columns null pointer returns error'req DuckDBError=appenderClearColumns 0

{}disconnect con
{}close db
⎕←↑r

⍝ ===== APPENDER ERROR API TEST =====
r←⊂'Test Appender Error API'
db←open':memory:'
con←connect db

{}query con'CREATE TABLE app_err_test(id INT PRIMARY KEY, name VARCHAR)'
(st appender)←api.duckdb_appender_create con '' 'app_err_test' 0
r,←⊂'Create appender for error API'req(DuckDBSuccess=st)∧appender≠0

:If (DuckDBSuccess=st)∧appender≠0
    r,←⊂'Begin first duplicate row'req DuckDBSuccess=appenderBeginRow appender
    r,←⊂'Append first duplicate id'req DuckDBSuccess=api.duckdb_append_int32 appender 1
    r,←⊂'Append first duplicate name'req DuckDBSuccess=api.duckdb_append_varchar appender 'first'
    r,←⊂'End first duplicate row'req DuckDBSuccess=appenderEndRow appender

    r,←⊂'Begin second duplicate row'req DuckDBSuccess=appenderBeginRow appender
    r,←⊂'Append second duplicate id'req DuckDBSuccess=api.duckdb_append_int32 appender 1
    r,←⊂'Append second duplicate name'req DuckDBSuccess=api.duckdb_append_varchar appender 'second'
    r,←⊂'End second duplicate row'req DuckDBSuccess=appenderEndRow appender

    r,←⊂'Close appender reports constraint error'req DuckDBError=appenderClose appender
    app_msg←appenderError appender
    r,←⊂'appender_error message available'req 0<≢app_msg
    r,←⊂'Destroy errored appender pointer is safe'req(DuckDBSuccess DuckDBError)∊⍨api.duckdb_appender_destroy appender
:EndIf

{}disconnect con
{}close db
⎕←↑r

