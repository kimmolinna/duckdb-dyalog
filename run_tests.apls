#! dyascript.exe
⍝ Link duck, init lib/, duck.db.runAllTests. Run with cwd = repo root.
⍝   dyascript.exe run_tests.apls     or     .\scripts\run-tests.ps1
⎕IO←0 ⋄ ⎕ML←1

root←⎕CD''
path←root,(~∨/(⊃⌽root)∊'/',⎕ucs 92)'/'
lib←path,'lib/'

⎕←'run_tests.apls — root=',path
]link.create duck path
duck.db.init lib
duck.db.runAllTests
⎕OFF 0
